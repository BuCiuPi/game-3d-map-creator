//
// Placeholders (from project config + contract source):
//   {{framework_usings}}   — framework using directives from project config
//   {{request_namespace}}  — config.request_namespace
//   {{Name}}               — e.g. ListRewards (full class name = Request{{Name}})
//   {{endpoint_path}}      — e.g. reward/api/v1/rewards/  (keep the trailing slash)
//   {{OperationMethod}}    — Get or Delete
//   {{DataType}}           — e.g. List<RewardApiData>, or object for no payload
//   {{path_params}}        — path-id properties (if any)
//   {{query_params}}       — query properties (if any)
// ============================================================
//
// There is NO request source generator in com.paul.common.networking @ beb0af1.
// ApiClient reads only the five virtual methods on RequestBase; override the ones
// this endpoint needs. Do not add [RequestGenerator]/[Get]/[ResourceKey]/
// [RequestParameter]/[RequestHeader] — nothing reads them.
// ============================================================

namespace {{request_namespace}}
{
    {{framework_usings}}

    /// <summary>
    /// <c>{{OperationMethod}} /{{endpoint_path}}</c> — one line on what it does, plus
    /// anything the payload does not make obvious (e.g. which id this returns).
    /// </summary>
    public class Request{{Name}} : RequestBase, IRestRequest, ITokenAuthenticatedRequest
    {
{{path_params}}
{{query_params}}

        [JsonIgnore]
        public string Token { get; set; }

        public override OperationMethod GetRequestMethod() => OperationMethod.{{OperationMethod}};

        public override string GetPath() => "{{endpoint_path}}";

        // Only when the route has {placeholders}:
        public override Dictionary<string, string> GetResources() => new()
        {
            ["session_id"] = SessionId,
        };

        // Only when the endpoint takes query parameters:
        public override Dictionary<string, string> GetParameters() => new()
        {
            ["page"] = Uri.EscapeDataString(Page ?? string.Empty),
        };

        public override Dictionary<string, string> GetHeaders() => new()
        {
            [Const.JwtAuthKeyHeader] = Token,
        };
    }

    public class Response{{Name}} : ResponseBase<{{DataType}}>
    {
    }
}

