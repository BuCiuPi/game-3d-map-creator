// --- Variant A: single object, wire -> model ---
public async UniTask<Result<{{ModelType}}>> {{MethodName}}(string someId, CancellationToken ct = default)
{
    var result = await SendAsync<Request{{Name}}, Response{{Name}}, {{DataType}}>(
        new Request{{Name}} { SomeId = someId }, ct);

    return Project(result, data => data.ToModel());
}

// --- Variant B: collection, with the null-payload guard ---
public async UniTask<Result<IReadOnlyList<{{ModelType}}>>> {{MethodName}}(CancellationToken ct = default)
{
    var result = await SendAsync<Request{{Name}}, Response{{Name}}, List<{{DataType}}>>(
        new Request{{Name}}(), ct);

    return Project(result, entries => (IReadOnlyList<{{ModelType}}>)
        (entries ?? new List<{{DataType}}>())
        .Select(entry => entry.ToModel())
        .ToList());
}

// --- Variant C: no meaningful payload (fire-and-confirm) ---
public async UniTask<Result<bool>> {{MethodName}}(string someId, CancellationToken ct = default)
{
    var result = await SendAsync<Request{{Name}}, Response{{Name}}, object>(
        new Request{{Name}} { SomeId = someId }, ct);

    return Project(result, _ => true);
}

