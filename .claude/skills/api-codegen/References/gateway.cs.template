// Placeholders:
//   {{gateway_namespace}} — config.gateway_namespace
//   {{Area}}              — the API area (one URL prefix), e.g. Reward -> IRewardApi
//   {{Domain}}            — the slice the endpoint serves (feature-domain-service)
//   {{Name}}              — e.g. ClaimReward
//   {{DataType}}          — wire type, e.g. RewardApiData
//   {{ModelType}}         — client type, e.g. RewardModel
//   {{MethodName}}        — e.g. ClaimRewardAsync
// ============================================================
//
// Read this first: the gateway returns Result<TModel>, never bare data. It maps
// wire -> model itself with Project(result, data => data.ToModel()), as the
// reference harness's owned gateways do (decision 0007); ApiData never leaves
// the gateway.
//
// ApiClient.SendRequestAsync<TResponse> has four outcomes and only one is a
// clean success:
//   2xx + success:true   -> envelope
//   2xx + success:false  -> envelope with Success == false   (business refusal)
//   4xx / 5xx / no network -> THROWS Cysharp.Threading.Tasks.UnityWebRequestException
//                           (UniTask's awaiter throws on ProtocolError/ConnectionError;
//                            the server's envelope is in .Text, the code in .ResponseCode)
//   empty body           -> null
// SendAsync below folds all four into Result<TData>, and Project maps a success
// payload while carrying a failure through untouched. Reuse that pair; do not call
// ApiClient.SendRequestAsync from a gateway method directly.
// ============================================================


// === 0. FIRST ENDPOINT ONLY — create Api/{{Area}}ApiGateway.cs ===

namespace {{gateway_namespace}}
{
    using System;
    using System.Collections.Generic;
    using System.Linq;
    using System.Threading;
    using Cysharp.Threading.Tasks;
    using Newtonsoft.Json;
    using Paul.Base.Networking.Runtime;
    using Paul.Base.Networking.Runtime.Request.Base;
    using Paul.Base.Networking.Runtime.Request.Base.Interfaces;
    using Paul.Game.Shared.Runtime.Networking;
    using Paul.Game.Shared.Runtime.Networking.Context;
    using Paul.Game.Shared.Runtime.Networking.ErrorHandling;

    public sealed class {{Area}}ApiGateway : I{{Area}}Api
    {
        #region Dependencies

        private readonly ApiClient _client;

        #endregion Dependencies

        #region Lifecycle

        public {{Area}}ApiGateway(ApiClient client)
        {
            _client = client;
        }

        #endregion Lifecycle

        #region Subroutines

        private async UniTask<Result<TData>> SendAsync<TRequest, TResponse, TData>(
            TRequest request, CancellationToken ct)
            where TRequest : RequestBase
            where TResponse : ResponseBase<TData>, new()
        {
            if (request is ITokenAuthenticatedRequest authenticated)
            {
                authenticated.Token = ApiContextBuilder.GetToken();   // already "Bearer <access>"
            }

            TResponse response;
            try
            {
                response = await _client.SendRequestAsync<TResponse>(request, ct);
            }
            catch (UnityWebRequestException e)
            {
                return Result<TData>.Fail(ToError(e));
            }
            catch (JsonException e)
            {
                return Result<TData>.Fail(new UnknownError("ResponseNotParsed", e.Message, 0));
            }

            // The package does not hand ct to UnityWebRequest; a cancelled call still completes.
            ct.ThrowIfCancellationRequested();

            if (response == null)
            {
                return Result<TData>.Fail(new UnknownError("EmptyResponse", "The server returned no body.", 0));
            }

            if (!response.Success)
            {
                return Result<TData>.Fail(new UnknownError(response.ErrorCode, response.Message, response.Status));
            }

            return Result<TData>.Ok(response.Data);
        }

        private static Result<TModel> Project<TData, TModel>(Result<TData> result, Func<TData, TModel> map)
        {
            return result.IsSuccess
                ? Result<TModel>.Ok(map(result.GetValue()))
                : Result<TModel>.Fail((IError)result.Error);
        }

        private static IError ToError(UnityWebRequestException e)
        {
            if (e.ResponseCode == 401)
            {
                return new TokenExpiredError();
            }

            ResponseBase<object> envelope = null;
            try
            {
                envelope = string.IsNullOrEmpty(e.Text) ? null : JsonConvert.DeserializeObject<ResponseBase<object>>(e.Text);
            }
            catch (JsonException)
            {
                // a non-JSON error page (proxy, CDN); keep the transport error below
            }

            return new UnknownError(
                envelope?.ErrorCode ?? e.Result.ToString(),
                envelope?.Message ?? e.Error,
                (int)e.ResponseCode);
        }

        #endregion Subroutines
    }
}

